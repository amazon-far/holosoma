#usda 1.0
(
    defaultPrim = "lidar_visual_collision_target"
    metersPerUnit = 1.0
    upAxis = "Z"
)

# A fixed LiDAR oracle with two surfaces on the same downward ray:
# - the visible, collision-enabled cube has its top at z=0.6 m;
# - the closer guide-purpose CollisionAPI proxy has its top at z=1.1 m.
#
# Default optical discovery must return the visible surface. An explicit mesh path to the
# collision proxy must remain authoritative and return the closer surface.
def Xform "lidar_visual_collision_target" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 1.0

    def Xform "Visuals"
    {
        def Cube "visible" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.2
            double3 xformOp:translate = (0.0, 0.0, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.1, 0.8, 0.2)]
        }
    }

    def Xform "Collisions"
    {
        token purpose = "guide"

        def Cube "proxy" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.2
            double3 xformOp:translate = (0.0, 0.0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
