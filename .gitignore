# The IsaacSim URDF->USD converter writes next to the URDF, i.e. one level deeper:
# data/robots/<robot>/converted_rank<local_rank>/ (isaacsim_articulation_cfg.py).
src/holosoma/holosoma/data/robots/*/converted/
src/holosoma/holosoma/data/robots/*/converted_rank*/

